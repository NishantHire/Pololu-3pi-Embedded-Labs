target C {
  platform: "RP2040",
  single-threaded: true
}

preamble {=
  #include <math.h>
=}

reactor Tilt {
  input x: float
  input y: float
  input z: float

  output pitch: float
  output roll: float

  reaction(x, y, z) -> pitch, roll {=
    const float RAD_TO_DEG = 180.0f / 3.14159265358979323846f;

    float ax = x->value;
    float ay = y->value;
    float az = z->value;

    float pitch_degrees =
        atan2f(ax, sqrtf((ay * ay) + (az * az))) * RAD_TO_DEG;

    float roll_degrees =
        atan2f(ay, sqrtf((ax * ax) + (az * az))) * RAD_TO_DEG;

    lf_set(pitch, pitch_degrees);
    lf_set(roll, roll_degrees);
  =}
}
