target C {
  platform: {
    name: "rp2040",
    board: "pololu_3pi_2040_robot"
  },
  single-threaded: true,
  keepalive: true
}

preamble {=
  #include <stdio.h>
  #include <pico/stdlib.h>
  #include <hardware/gpio.h>
=}

main reactor {
  preamble {=
    void button_callback(uint gpio, uint32_t events) {
      printf("GPIO: %u, Events: %lu\n",
             gpio, (unsigned long)events);
    }
  =}

  reaction(startup) {=
    gpio_init(25);
    gpio_set_dir(25, GPIO_IN);
    gpio_pull_up(25);

    gpio_set_irq_enabled_with_callback(
      25,
      GPIO_IRQ_EDGE_FALL,
      true,
      button_callback
    );
  =}
}